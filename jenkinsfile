pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        APP_NAME = 'hello-world'
        WAR_FILE = 'target/hello-world-1.0.0.war'

        NEXUS_HOST = 'localhost:8081'
        NEXUS_REPO = 'maven-releases'
        NEXUS_CRED_ID = 'nexus_credentials'

        TOMCAT_HOST = 'localhost:8082'
        TOMCAT_CRED_ID = 'tomcat-credentials'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build') {
            steps {
                sh 'mvn clean package'
            }
        }

        stage('Upload to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.NEXUS_CRED_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        curl -f \
                        -u "$NEXUS_USER:$NEXUS_PASS" \
                        --upload-file "$WAR_FILE" \
                        "http://$NEXUS_HOST/repository/$NEXUS_REPO/$APP_NAME/$APP_NAME-$BUILD_NUMBER.war"
                    '''
                }
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.TOMCAT_CRED_ID,
                        usernameVariable: 'TOMCAT_USER',
                        passwordVariable: 'TOMCAT_PASS'
                    )
                ]) {
                    sh '''
                        curl -f \
                        -u "$TOMCAT_USER:$TOMCAT_PASS" \
                        -T "$WAR_FILE" \
                        "http://$TOMCAT_HOST/manager/text/deploy?path=/$APP_NAME&update=true"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'target/*.war', fingerprint: true
        }

        success {
            echo 'Deployment successful'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}