pipeline {
    agent any

    triggers {
        githubPush()
    }

    environment {
        APP_NAME = 'hello-world'
        WAR_FILE = 'target/hello-world-1.0.0.war'

        NEXUS_HOST = 'localhost:8081'
        NEXUS_REPO = 'maven-release-hw'
        NEXUS_CRED_ID = 'nexus_credentials'

        DOCKER_HOST = 'localhost:8083'
        DOCKER_IMAGE = 'localhost:8083/docker-hw/hello-world'
        DOCKER_CRED_ID = 'nexus_credentials'

        TOMCAT_HOST = 'localhost:8082'
        TOMCAT_CRED_ID = 'tomcat_credentials'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build WAR') {
            steps {
                sh '''
                    export PATH="/opt/homebrew/bin:$PATH"
                    mvn clean package
                '''
            }
        }

        stage('Upload WAR to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.NEXUS_CRED_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        curl -f \
                        -u "$NEXUS_USER:$NEXUS_PASS" \
                        --upload-file "$WAR_FILE" \
                        "http://$NEXUS_HOST/repository/$NEXUS_REPO/$APP_NAME/$APP_NAME-$BUILD_NUMBER.war"
                    '''
                }
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"
                    docker build -t "$DOCKER_IMAGE:$BUILD_NUMBER" .
                '''
            }
        }

        stage('Push Docker Image to Nexus') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.DOCKER_CRED_ID,
                        usernameVariable: 'NEXUS_USER',
                        passwordVariable: 'NEXUS_PASS'
                    )
                ]) {
                    sh '''
                        export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"

                        echo "$NEXUS_PASS" | docker login "$DOCKER_HOST" \
                        -u "$NEXUS_USER" \
                        --password-stdin

                        docker push "$DOCKER_IMAGE:$BUILD_NUMBER"
                    '''
                }
            }
        }

        stage('Deploy to Tomcat') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: env.TOMCAT_CRED_ID,
                        usernameVariable: 'TOMCAT_USER',
                        passwordVariable: 'TOMCAT_PASS'
                    )
                ]) {
                    sh '''
                        curl -f \
                        -u "$TOMCAT_USER:$TOMCAT_PASS" \
                        -T "$WAR_FILE" \
                        "http://$TOMCAT_HOST/manager/text/deploy?path=/$APP_NAME&update=true"
                    '''
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'target/*.war', fingerprint: true
        }

        success {
            echo 'WAR and Docker image deployed successfully'
        }

        failure {
            echo 'Pipeline failed'
        }
    }
}